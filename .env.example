# AI provider failover
# Order: Gemini -> Groq -> OpenRouter -> OpenAI
AI_PROVIDER_ORDER=gemini,groq,openrouter,openai

# Gemini
GEMINI_API_KEY=
GEMINI_TUTOR_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_TUTOR_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_TUTOR_MODEL=openrouter/free

# OpenAI (last-resort fallback)
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-5

# Current RAG embedding configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
